CATALOG_PATH=./data/catalog.json

# Storage: file (local JSON files, default) | s3 (needs `pip install -e ".[aws]"`)
STORAGE=file
CONVERSATIONS_DIR=./conversations
# For STORAGE=s3. Region and credentials come from the standard AWS environment
# (AWS_REGION, AWS_PROFILE) or the IAM role when running on AWS.
S3_BUCKET=
S3_PREFIX=conversations/
S3_TIMEOUT_SECONDS=5
S3_MAX_ATTEMPTS=3

# LLM
ANTHROPIC_API_KEY=
# claude-opus-5-5 (default) | claude-sonnet-5-5 | ...
ANTHROPIC_MODEL=claude-opus-5-5
LLM_EFFORT=low
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2

# Interview
MAX_INPUT_CHARS=2000
MAX_RECOMMENDATIONS=3
FRUSTRATION_STREAK=2

# Speech (optional: without keys, text works and replies have no audio)
# Speech-to-text provider: deepgram (default) | elevenlabs (Scribe, reuses ELEVENLABS_API_KEY)
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v2
SPEECH_TIMEOUT_SECONDS=15
STT_MIN_CONFIDENCE=0.4

# HTTP API (make serve)
CORS_ORIGINS=["http://localhost:5173"]
MAX_AUDIO_BYTES=5000000

# Logging: text | json (one object per line, for CloudWatch)
LOG_LEVEL=INFO
LOG_FORMAT=text
