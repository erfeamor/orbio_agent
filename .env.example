# Storage backend: "file" (local JSON files) or "s3" (AWS, later step)
STORAGE=file
CONVERSATIONS_DIR=./conversations
CATALOG_PATH=./data/catalog.json

# LLM
ANTHROPIC_API_KEY=
# claude-opus-5-5 (default) | claude-sonnet-5-5 | ...
ANTHROPIC_MODEL=claude-opus-5-5
LLM_EFFORT=low

# Speech (optional: without keys, text works and replies have no audio)
# Speech-to-text provider: deepgram (default) | elevenlabs (Scribe, reuses ELEVENLABS_API_KEY)
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
STT_MIN_CONFIDENCE=0.4

# HTTP API (make serve)
CORS_ORIGINS=["http://localhost:5173"]
MAX_AUDIO_BYTES=5000000
