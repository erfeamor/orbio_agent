# Storage backend: "file" (local JSON files) or "s3" (AWS, later step)
STORAGE=file
CONVERSATIONS_DIR=./conversations
CATALOG_PATH=./data/catalog.json

# Provider keys (used from step 2 onwards)
ANTHROPIC_API_KEY=
# claude-opus-5-5 (default) | claude-sonnet-5-5 | ...
ANTHROPIC_MODEL=claude-opus-5-5
LLM_EFFORT=low
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
